<UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Amanita/Editor/Resources/Stylesheets/VarRows/variableRowStyle.uss?fileID=7433441132597879392&amp;guid=dc36f721c9349184d99e907b905f9005&amp;type=3#variableRowStyle" />
    <Style src="project://database/Assets/Amanita/Editor/Resources/Stylesheets/VarRows/vectorTwoStyle.uss?fileID=7433441132597879392&amp;guid=b3549d0dad041194794491612e4b3114&amp;type=3#vectorTwoStyle" />
    <engine:VisualElement name="VarRowRoot">
        <engine:Label text="VecTwo" name="TypeLabel" class="varRowTypeLabel" />
        <engine:TextField name="KeyInput" hide-placeholder-on-focus="true" binding-path="key" class="varRowInputField keyInput" />
        <engine:VisualElement name="ValueFieldHolder" view-data-key="ValueField">
            <editor:PropertyField name="ValueField" data-source-type="UnityEngine.Vector2, UnityEngine.CoreModule" binding-path="value" />
        </engine:VisualElement>
        <engine:EnumField value="Private" type="Amanita.VScripting.VariableScope, Amanita" name="Scope" data-source-type="Amanita.VScripting.VariableScope, Amanita" binding-path="scope" class="scopeRoot" />
        <engine:Button text="-" name="RemoveButton" class="removeButton" />
    </engine:VisualElement>
</UXML>
