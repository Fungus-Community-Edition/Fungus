.numericField
{
	-unity-font-definition: resource('Fonts/Amaranth/Amaranth-Regular');
	color: rgb(229, 229, 229);
	-unity-text-align: middle-left;
	width: 100%;
	height: 100%;
	padding: 0px;
	margin: 0px;
	background-color: #1A1A1A;
	border-color: rgb(229, 229, 229);
	border-radius: 2px;
}

.numericField > #unity-text-input
{
	-unity-font-definition: resource('Fonts/Amaranth/Amaranth-Regular');
	color: rgb(229, 229, 229);
	-unity-text-align: middle-left;
	width: 100%;
	height: 100%;
	padding: 0px 0px 0px 2px;
	margin: 0px;
	background-color: rgb(20, 20, 20);
	font-size: 16px;
}

.numericField > Label
{
	-unity-text-align: middle-left;
	font-size: 18px;
}

.varRowTypeLabel
{
	background-color: #3C5E4F;
}