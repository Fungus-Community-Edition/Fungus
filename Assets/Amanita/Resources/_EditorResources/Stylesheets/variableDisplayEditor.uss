/* Individual rows */
#VariableDisplayEditorRoot
{
    -unity-font-definition: resource('Fonts/Amaranth/Amaranth-Regular');
    background-color: rgba(0, 0, 255, 0.05);
    max-width: 450px;
}

#varHeaderBar
{
    display: flex;           /* In case defaults get overridden */
    flex-direction: row;
    align-items: center;     /* Vertically center label & button */
    justify-content: flex-start;
    margin-bottom: 5px;
    font-size: 20px;
    height: 40px;

}

/* Optional: style tweaks for children for better visual balance */
#varHeaderBar > #varCountLabel
{
    min-width: 70px;
    height: 100%;
    -unity-text-align: left-middle;
}

#varHeaderBar > #addVarButton 
{
    min-width: 110px;
    height: 100%;
}

#addVarButton
{
    background-color: white;
    color: black;
    height: 30px;

}

/* The only scroll cap you need */
#rowList 
{
    max-height: 250px;
}

.unity-scroll-view__content-container 
{
    height: auto !important;
    flex-grow: 0 !important;
    flex-shrink: 0 !important;
}

#rowList .unity-scroll-view__content-viewport
{
    align-items: flex-start !important;
}

#rowList .unity-scroll-view__content-container 
{
    height: auto !important;
    align-items: flex-start !important;
}