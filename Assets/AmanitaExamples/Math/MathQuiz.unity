  conversationText:
    _backingVarRef:
      _itemId: 0
      _owningSource: {fileID: 0}
      legacyOwningFc: {fileID: 0}
      legacyOwningVsa: {fileID: 0}
    _value: "john bored left: I have a game for you. \nsherlock sarcastic right:
      Do you, John.\nAlright, let's have it then.\njohn: I've picked 2 numbers at
      random between 1 and 100.\nsherlock eyeroll: I know binary search John.\njohn
      apologetic: No, it's not that game.\nconfident: You need to deduce the starting
      numbers based on their results.\nsherlock thinking: Deduce you say, ... Proceed.\njohn
      pleased: One value multiplied by the other is {$AMulB}.\nThe atan of their
      ratio is {$AtanAOverB}\nThe maximum value passed through a 1-100 S Curve is
      {$maxSCurve}\nOne value's Log is {$LogA}\nOne Value's Exp is {$ExpB}\nThe square
      root of the maximum value is {$SqrtMax}\nAND... the square root of the maximum
      remapped between the two values is {$remapped}\nsherlock smirk: ...\njohn annoyed:
      Really!\nsherlock triumphant: {$StartingA} & {$StartingB}\njohn laughing: Yes,
      Amazing!\nsherlock hide:\njohn hide:"
    stringRef: {fileID: 0}
    stringVal: 
