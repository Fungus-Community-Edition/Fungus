:root {
    --fc-name-label-color: var(--unity-text-default-color);
}

.fcNameLabel {
    font-size: 20px;
    font-weight: bold;
    margin-top: 10px;
    margin-left: 10px;
    --unity-text-align: middle-center;
    color: var(--fc-name-label-color);
    position: absolute;
}

.zoom-label {
    width: 160px;
    height: 50px;
    margin: 10px 10px 0 0;
    padding: 0;
    font-size: 20px;
    font-weight: bold;
    align-self: flex-end;
    -unity-text-align: upper-right;
}

