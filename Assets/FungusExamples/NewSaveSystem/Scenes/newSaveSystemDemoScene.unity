  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 12
  indentLevel: 0
  storyText: It applies the appropriate action to the selected slot, if there is
    any. Look at the blocks in the UIActionHandler flowchart to see how it's done.
  description: 
  character: {fileID: 1495643923}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
