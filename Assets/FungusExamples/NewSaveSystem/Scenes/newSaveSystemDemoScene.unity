  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 14
  indentLevel: 0
  storyText: 'If you want a save menu with the slots having screenshots (a la Ren''Py),
    you may need to do a little extra scripting. '
  description: 
  character: {fileID: 1495643923}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
