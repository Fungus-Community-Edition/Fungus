#TypeLabel
{
	font-size: 16px;
}

.varRowTypeLabel
{
	background-color: #3C5E4F;
}

.textField
{
	-unity-font-definition: resource('Fonts/Amaranth/Amaranth-Regular');
	color: rgb(229, 229, 229);
	font-size: 18px;
	height: 100%;
	-unity-text-align: middle-left;
	padding: 0px;
	margin: 0px;
}

.textField > #unity-text-input
{
	background-color: rgb(26, 26, 26);
	height: 100%;
}