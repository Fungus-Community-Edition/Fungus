<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Amanita/Resources/_EditorResources/Stylesheets/variableDisplayEditor.uss?fileID=7433441132597879392&amp;guid=9c0e2f55938933348bc8eb8a71cf2058&amp;type=3#variableDisplayEditor" />
    <ui:VisualElement name="VariableDisplayEditorRoot" class="variable-editor" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
        <ui:Foldout text="Variables" name="Foldout" style="font-size: 28px; color: rgb(229, 229, 229); margin-top: 15px; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:VisualElement name="varHeaderBar" view-data-key="varHeaderBar">
                <ui:Label name="varCountLabel" text="Count: 0" view-data-key="varCountLabel" class="var-count" />
                <ui:Button name="addVarButton" text="Add Variable" view-data-key="addVarButton" class="add-button" />
            </ui:VisualElement>
            <ui:ScrollView name="rowList" view-data-key="rowList" horizontal-scroller-visibility="Auto" vertical-scroller-visibility="AlwaysVisible" class="row-list" />
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
