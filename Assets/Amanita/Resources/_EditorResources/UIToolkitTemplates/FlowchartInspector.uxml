<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <engine:Template name="VariableDisplayEditor" src="project://database/Assets/Amanita/Resources/_EditorResources/UIToolkitTemplates/VariableDisplayEditor.uxml?fileID=9197481963319205126&amp;guid=43fc496ae8989fe449ddd9c69138ed9b&amp;type=3#VariableDisplayEditor" />
    <Style src="project://database/Assets/Amanita/Resources/_EditorResources/Stylesheets/inspectorStyle.uss?fileID=7433441132597879392&amp;guid=9e22a25197c37394cb88cdfa12198daf&amp;type=3#inspectorStyle" />
    <engine:VisualElement name="InspectorRoot" style="flex-grow: 1;">
        <engine:TextField label="Description" placeholder-text="Insert desc here" select-all-on-mouse-up="false" select-all-on-focus="false" multiline="true" name="DescField" hide-placeholder-on-focus="true" binding-path="_description" vertical-scroller-visibility="Auto" />
        <engine:TextField label="Localization ID" name="LocalizationIDField" binding-path="_localizationId" hide-placeholder-on-focus="true" />
        <engine:Foldout text="Editor Only" name="EditorOnlyFoldout">
            <engine:Toggle label="Color Commands" name="ColorCommands" value="false" binding-path="_colorCommands" />
            <engine:Toggle label="Hide Components" name="HideComponents" binding-path="_hideComponents" />
            <engine:Toggle label="Save Selections" name="SaveSelections" binding-path="_saveSelections" />
            <engine:Slider label="Slider" value="42" high-value="5" name="StepPause" binding-path="_stepPause" fill="true" show-input-field="true" />
            <editor:PropertyField name="HideCommands" binding-path="_hideCommands" />
        </engine:Foldout>
        <engine:Foldout text="Lua Support&#10;" name="LuaSupport">
            <editor:ObjectField label="Lua Environment" name="LuaEnvironment" binding-path="_luaEnvironment" />
            <engine:TextField label="Lua Binding Name" placeholder-text="filler text" name="BindingName" binding-path="_luaBindingName" />
        </engine:Foldout>
        <engine:Foldout text="Save Sys Involvement" name="SaveSysInvolvement">
            <engine:Toggle label="Include in Saves" name="IncludeinSaves" binding-path="_includeInSaves" />
            <engine:Toggle label="Save Blocks" name="SaveBlocks" binding-path="_saveBlocks" />
            <engine:Toggle label="Save Variables" name="SaveVariables" binding-path="_saveVariables" />
            <engine:IntegerField label="Load Priority" value="42" name="LoadPriority" binding-path="_loadPriority" />
        </engine:Foldout>
        <engine:Button text="Open Flowchart Window" name="OpenFlowchartWindow" />
        <engine:Instance template="VariableDisplayEditor" name="VariableDisplayEditor" />
    </engine:VisualElement>
</engine:UXML>
