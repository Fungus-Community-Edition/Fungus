  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 4
  indentLevel: 0
  storyText: 'The desk is simple and sturdy, a little impersonal. The lamp looks
    like a solid piece of chrome and it''s currently switched off. '
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
