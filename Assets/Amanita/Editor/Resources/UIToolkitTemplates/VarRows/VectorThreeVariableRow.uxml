<UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Amanita/Resources/_EditorResources/Stylesheets/variableRowStyle.uss?fileID=7433441132597879392&amp;guid=dc36f721c9349184d99e907b905f9005&amp;type=3#variableRowStyle" />
    <Style src="project://database/Assets/Amanita/Resources/_EditorResources/Stylesheets/vectorThreeStyle.uss?fileID=7433441132597879392&amp;guid=946b58ee69bdd45449790de143a578ee&amp;type=3#vectorThreeStyle" />
    <engine:VisualElement name="VarRowRoot">
        <engine:VisualElement name="TopRow" style="flex-grow: 1;">
            <engine:Label text="VecThree" name="TypeLabel" view-data-key="" class="varRowTypeLabel" />
            <engine:TextField name="KeyInput" view-data-key="" hide-placeholder-on-focus="true" binding-path="key" class="varRowInputField keyInput" />
            <engine:VisualElement name="SpaceFiller" style="flex-grow: 1;" />
            <engine:EnumField value="Private" type="Amanita.VScripting.VariableScope, Amanita" name="Scope" data-source-type="Amanita.VScripting.VariableScope, Amanita" view-data-key="" binding-path="scope" class="scopeRoot" />
            <engine:Button text="-" name="RemoveButton" view-data-key="" class="removeButton" />
        </engine:VisualElement>
        <engine:VisualElement name="ValueFieldHolder" view-data-key="ValueField">
            <engine:Vector3Field name="VectorThreeField" binding-path="value" />
        </engine:VisualElement>
    </engine:VisualElement>
</UXML>
